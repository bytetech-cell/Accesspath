# ============ ACCESSPATH settings ============
# Copy this file to ".env" (same folder) and fill in your keys.

# --- TinyFish web agent (step 4: Attempt journey) ---
# Get a key at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=
TINYFISH_TIMEOUT_SECONDS=300
# Max seconds an audit waits for TinyFish before using the fast local agent
TINYFISH_MAX_WAIT_SECONDS=90

# --- LLM for explanations + fixes (step 7) ---
# auto = use whichever key is filled. Leave all empty to use the built-in fix library.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Database ---
# Empty = SQLite file in backend/data (zero setup).
# PostgreSQL example (install requirements-postgres.txt first):
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/accesspath
DATABASE_URL=

# --- Browser ---
# Set HEADLESS=false to watch Chromium do the keyboard journey on your screen
HEADLESS=true
MAX_TABS_PER_STEP=60
PAGE_TIMEOUT_MS=45000
# Use the Chrome installed on your computer (better with bot-protected sites)
USE_SYSTEM_CHROME=true
# Set true only if you see ERR_HTTP2 errors
DISABLE_HTTP2=false

# --- Server ---
HOST=127.0.0.1
PORT=8000
